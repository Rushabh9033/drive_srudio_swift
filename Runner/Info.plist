<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Drive Studio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>drive_studio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- `location` enables CLLocationManager to keep delivering
		     GPS fixes while the app is in the background. The host
		     app uses those fixes to update the App Group telemetry
		     snapshot and request widget reloads so the home-screen
		     speedometer reflects real-time speed without the user
		     opening the app. Apple requires both this entry AND a
		     matching always-authorization purpose string (see below)
		     AND `allowsBackgroundLocationUpdates = true` on the
		     location manager. -->
		<string>location</string>
		<!-- `fetch` enables BGTaskScheduler-driven BGAppRefreshTask
		     runs. iOS wakes the app for ~30 seconds at OS-chosen
		     intervals (typically minutes to hours) so the widget
		     gallery stays fresh even when the user hasn't driven
		     in a while. The matching handler lives in
		     AppDelegate.swift's `handleAppRefresh(_:)` and calls
		     TelemetryService.shared.snapshotAndSave() +
		     WidgetCenter.shared.reloadAllTimelines(). -->
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.drivestudio.app.refresh</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Drive Studio needs access to your microphone to record custom vehicle audio prompts and cues.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Live sensors: battery_plus (UIDevice) + connectivity_plus (NWPathMonitor).
	     No CoreBluetooth scanning — do NOT add NSBluetoothAlwaysUsageDescription
	     unless a future build starts BT LE scan. Car link on iPhone = manual toggle. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Drive Studio uses your photo library for custom vehicle images and widget layer artwork.</string>
	<!-- NSPhotoLibraryAddUsageDescription intentionally absent. Drive Studio
	currently only READS photos (PhotosPicker for vehicle / widget layer
	artwork); it does not write to the user's library. Declaring
	NSPhotoLibraryAddUsageDescription without an actual save path is a
	rejection risk, so it stays out until a future Export feature is added
	and a UIImageWriteToSavedPhotosAlbum (or equivalent) call site exists. -->
	<!-- NSCameraUsageDescription intentionally absent. The editor currently
	only imports images from the photo library (PhotosPicker); no
	UIImagePickerController in `camera` mode is presented. Declaring the
	camera permission without a real capture flow is a rejection risk.
	Add it back when a capture-from-camera button is added to
	`EditorScreen.swift`. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Drive Studio uses your location while the app is open to show live GPS speed on speedometer widgets. Speed is never invented when GPS is unavailable.</string>
	<!-- Always-authorization purpose string. Required by Apple for any
	app that calls `requestAlwaysAuthorization()`. Drive Studio now
	declares the `location` UIBackgroundModes entry and enables
	background GPS so the home-screen speedometer stays accurate
	while driving without the app being open. iOS will surface this
	string on the second-step "Always Allow" prompt. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Drive Studio keeps reading GPS speed in the background while you're driving so the home-screen speedometer, Lock-Screen widget, and Dynamic Island update in real time without unlocking your phone. Background location stops automatically when you've been parked for 5 minutes. You can disable background location at any time in Settings → Drive Studio → Location.</string>
	<!-- Live Activities: required for ActivityKit-based Dynamic Island
	     + Lock Screen UI. Without this key, ActivityKit.start() is a
	     no-op and ActivityConfiguration widgets never appear. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Frequency API for Live Activities (iOS 16.2+): lets us declare
	     an update budget. Set to "frequent" so the Dynamic Island can
	     refresh every ~30s with new speed without iOS aggressively
	     throttling — this matches Google Maps' real-time behavior. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!-- Flutter / go_router deep links for drivestudio:// -->
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.drivestudio.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>drivestudio</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
</dict>
</plist>
